/*
 * XIAO nRF54LM20A + PAW3395 接线（依据 P2 原理图网表）
 *
 *   SCLK    -> D8  = P1.04   (spi23 SCK)
 *   MISO    -> D9  = P1.05   (spi23 MISO)
 *   MOSI    -> D10 = P1.06   (spi23 MOSI)
 *   NCS     -> D0  = P1.00   软件手动控制（burst 需保持 CS 低，故不进 SPI 控制器）
 *   MOTION  -> D1  = P1.31
 *   NRESET  -> D6  = P1.08
 *   WHEEL_A -> D2  = P1.30   阶段 2
 *   WHEEL_B -> D3  = P1.29   阶段 2
 *   BTN_INT -> D7  = P1.09   阶段 2
 *   I2C SDA -> D4  = P1.03   阶段 2
 *   I2C SCL -> D5  = P1.07   阶段 2
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	zephyr,user {
		paw-ncs-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
		paw-motion-gpios = <&gpio1 31 GPIO_ACTIVE_LOW>;
		paw-nreset-gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
		/* 滚轮编码器 A/B 与按键扩展 INT（上拉输入，编码器开关对地）。
		 * BTN_INT 也上拉：PCF8574 的 INT 是开漏输出，且线没接时也必须读成
		 * "无效"，否则主循环每 2 ms 都会去读一次 I2C。
		 */
		wheel-a-gpios = <&gpio1 30 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		wheel-b-gpios = <&gpio1 29 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		btn-int-gpios = <&gpio1 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};
};

/* D6/D7 被板级默认开启的 uart21 占用；本设计把这两个脚当普通 GPIO 用
 * （D6=NRESET、D7=BTN_INT），因此关掉 uart21。
 * 控制台仍在 uart20（SAMD11 桥 -> COM6），不受影响。
 */
&uart21 {
	status = "disabled";
};

/* 板级默认启用的板载 IMU（LSM6DS3TR-C，XIAO Sense 版才有）。
 * 本设计不用它，留着只会在开机刷一条 "LSM6DSL: Failed to initialize chip"。
 */
&lsm6ds3tr_c {
	status = "disabled";
};

/* PAW3395 挂在 spi23（D8/D9/D10）。
 * 刻意不配 cs-gpios：NCS 由 paw3395 驱动用 GPIO 手动拉低/抬高，
 * 因为 motion burst 要求 CS 在整个读序列里保持低电平。
 */
&spi23 {
	status = "okay";
	pinctrl-0 = <&spi23_default>;
	pinctrl-1 = <&spi23_sleep>;
	pinctrl-names = "default", "sleep";
};

/* PCF8574T 挂在 XIAO 外部 I2C：D4=SDA=P1.03 / D5=SCL=P1.07，节点为 i2c22
 * （板级 connector 文件里的 xiao_i2c: &i2c22）。引脚映射来自
 * xiao_nrf54lm20a_nrf54lm20a-pinctrl.dtsi 的 i2c22_default/sleep
 * （NRF_PSEL(TWIM_SDA, 1, 3) / NRF_PSEL(TWIM_SCL, 1, 7)）。
 * 板级默认给的是 400 kHz，PCF8574 只支持 100 kHz，这里覆盖。
 */
&i2c22 {
	status = "okay";
	pinctrl-0 = <&i2c22_default>;
	pinctrl-1 = <&i2c22_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <100000>;
};
